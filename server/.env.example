# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=papermind

# Ruta local a los PDFs para ingesta por lote
DOCS_PATH=../data/samples

# Embeddings (OpenAI)
EMBEDDINGS_MODEL=text-embedding-3-large
OPENAI_API_KEY=sk-...

# OCR para PDFs vectorizados (Gemini Flash)
GEMINI_API_KEY=AIza...

# Reranking (Cohere)
COHERE_API_KEY=...
RERANKER_MODEL=rerank-multilingual-v3.0
